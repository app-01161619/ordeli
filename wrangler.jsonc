{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ordeli",
  "main": "./worker.js",
  "compatibility_date": "2026-09-02",
  "secrets": {
    "required": ["SUPABASE_SECRET_KEY"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/t/*", "/api/*"]
  }
}
